# Optional. Copy to .env.local to point local development at another Supabase
# project. Without it, local development and preview builds use the staging
# project and builds of main use production (see vite.config.ts).
# Both values are public by design (they end up in the browser bundle);
# data is protected by row-level security in the database, not by hiding these.
# Find them in Supabase: Project Settings > API Keys / Data API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
