# Security headers for every response from Cloudflare Workers static assets
# (https://developers.cloudflare.com/workers/static-assets/headers/).
#
# Content-Security-Policy: the app loads only its own scripts, styles, fonts
# and images; the only other server it talks to is Supabase (production and
# staging, for preview builds) and, when the captcha is switched on, Cloudflare
# Turnstile. Adding a third-party service means adding it here, and to the
# privacy policy.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://ubjwlxcawxwrgolszlkz.supabase.co https://dghypouxfnfcdvpylznt.supabase.co; manifest-src 'self'; worker-src 'none'; object-src 'none'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=()

# Built files carry a content hash in their name, so a changed file gets a
# new address: browsers can keep them for a year without asking again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
